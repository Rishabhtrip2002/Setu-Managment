rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for Setu Management CRM collections:
    // (Only authenticated staff/admin can read and write text CRM documents)
    match /leads/{leadId} {
      allow read, write: if isAuthenticated();
    }

    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    match /quotations/{quotationId} {
      allow read, write: if isAuthenticated();
    }

    match /payments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    match /followups/{followupId} {
      allow read, write: if isAuthenticated();
    }

    match /reminders/{reminderId} {
      allow read, write: if isAuthenticated();
    }

    match /whatsapp_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /templates/{templateId} {
      allow read, write: if isAuthenticated();
    }

    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    match /cold_leads/{coldLeadId} {
      allow read, write: if isAuthenticated();
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Fallback rule for development (set to true only for temporary testing if auth is not yet enforced)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
